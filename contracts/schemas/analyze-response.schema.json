{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://log-triage.local/contracts/v1/analyze-response.schema.json",
  "title": "Log Triage Analyze Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "summary", "findings", "events", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial"]},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "event_count", "finding_count", "priority"],
      "properties": {
        "text": {"type": "string"},
        "event_count": {"type": "integer", "minimum": 0},
        "finding_count": {"type": "integer", "minimum": 0},
        "priority": {"type": "string"}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "source", "line_start", "line_end"],
      "properties": {
        "event_id": {"type": "string"}, "source": {"type": ["string", "null"]},
        "line_start": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "code", "severity", "title", "description", "confidence", "evidence"],
      "properties": {
        "id": {"type": "string"}, "code": {"type": "string"}, "severity": {"type": "string"},
        "title": {"type": "string"}, "description": {"type": "string"},
        "confidence": {"type": ["string", "null"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "source", "source_line", "source_end_line", "timestamp", "severity", "service", "message", "parse_status"],
      "properties": {
        "event_id": {"type": "string"}, "source": {"type": ["string", "null"]},
        "source_line": {"type": ["integer", "null"], "minimum": 1},
        "source_end_line": {"type": ["integer", "null"], "minimum": 1},
        "timestamp": {"type": ["string", "null"]}, "severity": {"type": "string"},
        "service": {"type": ["string", "null"]}, "message": {"type": "string"}, "parse_status": {"type": "string"}
      }
    }
  }
}
